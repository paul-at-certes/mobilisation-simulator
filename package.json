{
  "name": "mobilisation-minister",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A turn-based crisis game about raising a UK deployable force. Every number is sourced.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && npm run assumptions && npm run typecheck && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-parameters.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node --experimental-strip-types scripts/sim.ts",
    "assumptions": "node scripts/build-assumptions.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
